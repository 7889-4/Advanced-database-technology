--SETP 4 : PARALLEL EXECUTION
-- Clean up for the parallel run
TRUNCATE TABLE Product_Revenue_Summary;

-- Enable parallel DML
ALTER SESSION ENABLE PARALLEL DML;

SET TIMING ON

-- Parallel INSERT (aggregating data from both nodes using the parallel hint)
INSERT /*+ APPEND PARALLEL(Product_Revenue_Summary, 8) */ 
INTO Product_Revenue_Summary
SELECT 
    ProductID, 
    SUM(Quantity) AS TotalQuantity, 
    SUM(SubTotal) AS TotalRevenue
FROM (
    -- Local Data (can benefit from parallel query on local table)
    SELECT /*+ PARALLEL(OrderDetail_KGL, 8) */ ProductID, Quantity, SubTotal FROM OrderDetail_KGL
    UNION ALL
    -- Remote Data (remote query execution is generally serial unless configured otherwise)
    SELECT ProductID, Quantity, SubTotal FROM OrderDetail_Other@LINK_TO_B
) 
GROUP BY ProductID;

COMMIT;

SET TIMING OFF

