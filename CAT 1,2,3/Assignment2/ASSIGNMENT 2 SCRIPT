DECLARE
    PRAGMA AUTONOMOUS_TRANSACTION;

BEGIN
    -- Insert into local node (Kigali)
    INSERT INTO Customer_KGL (CustomerID, FullName, Email, Phone, City)
    VALUES
    (6, 'Hakizimana Emmanuel', 'hakis@email.com', '0786666666', 'Kigali');
    
