    VALUES 
    (7, 'Isingizwe clenie', 'clenieis@email.com', '0787777777', 'Butare');
    
    -- Single commit for both transactions (Two-Phase Commit)
    COMMIT;
    
    DBMS_OUTPUT.PUT_LINE('Two-Phase Commit completed successfully');
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        DBMS_OUTPUT.PUT_LINE('Two-Phase Commit failed: ' || SQLERRM);
END;
/
