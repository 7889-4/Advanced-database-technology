-- Serial INSERT (aggregating data from both nodes)
INSERT INTO Product_Revenue_Summary 
SELECT 
    ProductID, 
    SUM(Quantity) AS TotalQuantity, 
    SUM(SubTotal) AS TotalRevenue
FROM (
    -- Local Data
    SELECT ProductID, Quantity, SubTotal FROM OrderDetail_KGL
    UNION ALL
    -- Remote Data
    SELECT ProductID, Quantity, SubTotal FROM OrderDetail_Other@LINK_TO_B
) 
