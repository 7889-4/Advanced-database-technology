INSERT INTO TRIPLE VALUES ('Patient4', 'hasDiagnosis', 'COVID19');

-- Taxonomy (classification) facts
INSERT INTO TRIPLE VALUES ('Influenza', 'isA', 'ViralInfection');
INSERT INTO TRIPLE VALUES ('CommonCold', 'isA', 'ViralInfection');
INSERT INTO TRIPLE VALUES ('COVID19', 'isA', 'ViralInfection');
INSERT INTO TRIPLE VALUES ('ViralInfection', 'isA', 'InfectiousDisease');
COMMIT;

-- FIXED recursive query
WITH ISA(CHILD, ANCESTOR) AS (
    -- Anchor: direct "isA" relationships
    SELECT S AS CHILD, O AS ANCESTOR 
    FROM TRIPLE 
    WHERE P = 'isA'
    
    UNION ALL
    
    -- Recursive: climb up the taxonomy hierarchy
    SELECT I.CHILD, T.O AS ANCESTOR  -- Fixed: corrected child/ancestor mapping
    FROM ISA I
    JOIN TRIPLE T ON I.ANCESTOR = T.S  -- Fixed: join on the ancestor becoming the new child
    WHERE T.P = 'isA'
)
SELECT DISTINCT 
    T.S AS PATIENT_ID
FROM TRIPLE T
JOIN ISA ON T.O = ISA.CHILD  -- Fixed: compare diagnosis to child in hierarchy
WHERE T.P = 'hasDiagnosis'
AND ISA.ANCESTOR = 'InfectiousDisease';  -- Fixed: check if ancestor is our target

