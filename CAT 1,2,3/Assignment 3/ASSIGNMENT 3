-- PROBLEM 3:  Deductive Databases - Referral/Supervision Chain
-- We need to find everyone's top supervisor and how many management levels they are below that person.
-- Create sample staff table
CREATE TABLE STAFF_SUPERVISOR (
       EMPLOYEE VARCHAR2(50),
        SUPERVISOR VARCHAR2(50)
        );

-- Insert test data
INSERT INTO STAFF_SUPERVISOR VALUES ('Alice', 'Bob');
INSERT INTO STAFF_SUPERVISOR VALUES ('Bob', 'Carol');
INSERT INTO STAFF_SUPERVISOR VALUES ('Carol', 'David');
INSERT INTO STAFF_SUPERVISOR VALUES ('David', NULL); -- CEO has no supervisor
INSERT INTO STAFF_SUPERVISOR VALUES ('Eve', 'Bob');
INSERT INTO STAFF_SUPERVISOR VALUES ('Frank', 'Eve');
COMMIT;

-- FIXED recursive query
WITH SUPERS(EMP, SUP, HOPS, PATH) AS (
    -- Anchor part: start with each employee and their direct supervisor
    SELECT 
        EMPLOYEE, 
        SUPERVISOR, 
        1 AS HOPS,  -- Fixed: start at 1 hop (not 0)
        TO_CHAR(EMPLOYEE) AS PATH
    FROM STAFF_SUPERVISOR
    WHERE SUPERVISOR IS NOT NULL  
    
    UNION ALL
    
    -- Recursive part: climb up the supervision chain
    SELECT 
        S.EMP,           -- Keep the original employee
        T.SUPERVISOR,    -- Move to next level supervisor  -- Fixed: join direction
        S.HOPS + 1,      -- Increment hop count
        S.PATH || '->' || T.SUPERVISOR  -- Build path
    FROM SUPERS S
    JOIN STAFF_SUPERVISOR T ON S.SUP = T.EMPLOYEE  -- Fixed: corrected join condition
    WHERE T.SUPERVISOR IS NOT NULL  -- Stop when no more supervisors
    AND INSTR(S.PATH, T.SUPERVISOR) = 0  -- Cycle prevention
)
-- Final selection: find the top supervisor for each employee
SELECT 
    EMP AS EMPLOYEE,
    SUP AS TOP_SUPERVISOR,
    HOPS AS MANAGEMENT_LEVELS
FROM SUPERS
WHERE SUP NOT IN (  -- This ensures we get the topmost supervisor
    SELECT EMPLOYEE FROM STAFF_SUPERVISOR WHERE SUPERVISOR IS NOT NULL
)
UNION ALL
-- Include employees who have no supervisor (like David)
SELECT 
    EMPLOYEE, 
    NULL AS TOP_SUPERVISOR, 
    0 AS MANAGEMENT_LEVELS
FROM STAFF_SUPERVISOR 
WHERE SUPERVISOR IS NULL
ORDER BY MANAGEMENT_LEVELS, EMPLOYEE;

-- PROBLEM 4:  Knowledge Bases - Infectious Disease Roll-Up
-- We need to find all patients who have diagnoses that are ultimately types of "InfectiousDisease" using a taxonomy (classification system).
-- Create the triple table (stores facts as Subject-Predicate-Object)
CREATE TABLE TRIPLE (
       S VARCHAR2(100), 
       P VARCHAR2(50), 
       O VARCHAR2(100)
       );

