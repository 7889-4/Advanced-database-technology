-- PROBLEM 2: Active Databases (ECA Trigger) - Bill Totals
-- We need a trigger that automatically updates the bill total whenever bill items change, but does it efficiently (once per bill, not once per item).
-- Create prerequisite tables
CREATE TABLE BILL (ID NUMBER PRIMARY KEY, TOTAL NUMBER(12,2));
CREATE TABLE BILL_ITEM (
    BILL_ID NUMBER, 
    AMOUNT NUMBER(12,2), 
    UPDATED_AT DATE,
    CONSTRAINT FK_BILL_ITEM_BILL FOREIGN KEY (BILL_ID) REFERENCES BILL(ID)
);
CREATE TABLE BILL_AUDIT (
    BILL_ID NUMBER, 
    OLD_TOTAL NUMBER(12,2),
    NEW_TOTAL NUMBER(12,2), 
    CHANGED_AT DATE
);

-- FIXED: Compound trigger that handles multiple operations efficiently
CREATE OR REPLACE TRIGGER TRG_BILL_TOTAL_CMP
FOR INSERT OR UPDATE OR DELETE ON BILL_ITEM
COMPOUND TRIGGER
    
    -- Declaration section: store affected bill IDs
    TYPE BILL_ID_TABLE IS TABLE OF NUMBER INDEX BY PLS_INTEGER;
    g_bill_ids BILL_ID_TABLE;
    
    -- Before each statement: clear the collection
    BEFORE STATEMENT IS
    BEGIN
        g_bill_ids.DELETE;
    END BEFORE STATEMENT;
    
    -- After each row: collect affected bill IDs
    AFTER EACH ROW IS
    BEGIN
        -- For INSERT: use new bill ID
        IF INSERTING THEN
            g_bill_ids(:NEW.BILL_ID) := 1;
        -- For UPDATE: use both old and new bill IDs (in case bill ID changed)
        ELSIF UPDATING THEN
            g_bill_ids(:NEW.BILL_ID) := 1;
            g_bill_ids(:OLD.BILL_ID) := 1;
        -- For DELETE: use old bill ID
        ELSIF DELETING THEN
            g_bill_ids(:OLD.BILL_ID) := 1;
        END IF;
    END AFTER EACH ROW;
    
    -- After statement: process all collected bills
    AFTER STATEMENT IS
        v_old_total NUMBER(12,2);
        v_new_total NUMBER(12,2);
    BEGIN
        -- Loop through all affected bill IDs
        FOR i IN 1..g_bill_ids.COUNT LOOP
            DECLARE
                v_bill_id NUMBER := g_bill_ids(i);
            BEGIN
                -- Get old total for audit
                SELECT TOTAL INTO v_old_total FROM BILL WHERE ID = v_bill_id;
                
                -- Calculate new total
                SELECT NVL(SUM(AMOUNT), 0) INTO v_new_total 
                FROM BILL_ITEM WHERE BILL_ID = v_bill_id;
                
                -- Update bill total
                UPDATE BILL SET TOTAL = v_new_total WHERE ID = v_bill_id;
                
                -- Insert audit record
                INSERT INTO BILL_AUDIT (BILL_ID, OLD_TOTAL, NEW_TOTAL, CHANGED_AT)
                VALUES (v_bill_id, v_old_total, v_new_total, SYSDATE);
                
            END;
        END LOOP;
    END AFTER STATEMENT;
    
END TRG_BILL_TOTAL_CMP;
/
