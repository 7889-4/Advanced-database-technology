-- IN NODE A
-- 3. Query lock views to show the waiting session (Requires DBA/PDB_DBA role)
SELECT
    L.SID AS WAITER_SID,
    S.SERIAL# AS WAITER_SERIAL,
    L.BLOCKING_SESSION AS BLOCKER_SID,
    BS.SERIAL# AS BLOCKER_SERIAL,
    S.EVENT,
    'Contesting Row: 201/1' AS CONTEXT
FROM 
    V$SESSION S
JOIN 
    V$SESSION BS ON S.BLOCKING_SESSION = BS.SID
JOIN 
    V$SESSION_WAIT W ON S.SID = W.SID
JOIN 
    V$LOCK L ON S.SID = L.SID
WHERE 
    W.EVENT LIKE 'SQL*Net message from dblink%' -- Waiting on a distributed transaction
    OR S.STATE = 'WAITING' AND S.ROW_WAIT_OBJ# IS NOT NULL;
