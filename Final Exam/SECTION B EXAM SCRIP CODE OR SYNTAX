-- 1. Create audit table
CREATE TABLE OrderInfo_AUDIT (
    OrderID NUMBER(10),
    Bef_Total NUMBER(12, 2),
    Aft_Total NUMBER(12, 2),
    Changed_At TIMESTAMP DEFAULT SYSTIMESTAMP
);

-- 2. Implement a statement-level AFTER DML trigger on OrderDetail_A

CREATE OR REPLACE TRIGGER trg_OrderDetail_Total
AFTER INSERT OR UPDATE OR DELETE ON OrderDetail_A
DECLARE
    V_OrderID_Key NUMBER(10);
    V_Old_Total NUMBER(12, 2);
    V_New_Total NUMBER(12, 2);
BEGIN
    -- This block executes once per statement (Statement-level)
    -- Update all affected OrderInfo rows (simpler logic than row-level for small scale)
    FOR rec IN (
        SELECT DISTINCT OrderID FROM OrderDetail_A
        -- In a real scenario, we'd check OLD/NEW table for affected OrderIDs
    ) LOOP
        V_OrderID_Key := rec.OrderID;
        
        -- Get old total before re-computation
        SELECT TotalAmount INTO V_Old_Total FROM OrderInfo_KGL WHERE OrderID = V_OrderID_Key;

        -- Re-compute the total for the OrderID
        SELECT NVL(SUM(SubTotal), 0) INTO V_New_Total FROM OrderDetail_A WHERE OrderID = V_OrderID_Key;

        -- Update the denormalized total
        UPDATE OrderInfo_KGL SET TotalAmount = V_New_Total WHERE OrderID = V_OrderID_Key;
        
        -- Log to audit table
        INSERT INTO OrderInfo_AUDIT (OrderID, Bef_Total, Aft_Total)
        VALUES (V_OrderID_Key, V_Old_Total, V_New_Total);
    END LOOP;
END;

